---
import Navigation from './Navigation.astro';

const { currentPath = '' } = Astro.props;
---
<header class="site-header">
  <div class="site-header-inner">
    <a class="site-brand" href="/" aria-label="Arye Deutsch home">
      <span class="site-mark-brand" aria-hidden="true">
        <img class="site-mark-img site-mark-light" src="/images/pi-star-black.png" alt="π*" />
        <img class="site-mark-img site-mark-dark" src="/images/pi-star-white.png" alt="π*" />
      </span>
      <span class="site-name">Arye Deutsch</span>
    </a>
    <Navigation currentPath={currentPath} />
  </div>
</header>
