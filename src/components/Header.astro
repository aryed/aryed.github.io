---
import Navigation from './Navigation.astro';

const { currentPath = '' } = Astro.props;
---
<header class="site-header">
  <div class="site-header-inner">
    <a class="site-brand" href="/" aria-label="Arye Deutsch home">
      <span class="site-mark" aria-hidden="true"><span class="site-mark-pi">&pi;</span><sub class="site-mark-star">*</sub></span>
      <span class="site-name">Arye Deutsch</span>
    </a>
    <Navigation currentPath={currentPath} />
  </div>
</header>
