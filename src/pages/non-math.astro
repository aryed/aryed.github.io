        <img src="/images/non-math/recovered/04-bee.jpg" alt="Bee inside a white flower" loading="lazy" />
        <img src="/images/non-math/recovered/05-butterfly.jpg" alt="Butterfly resting on the ground" loading="lazy" />
      </div>
    </div>

    <div class="photo-gallery-row photo-gallery-row--5-4-3">
      <img src="/images/non-math/recovered/06-backlit-flower.jpg" alt="Flower backlit by the sun" loading="lazy" />
      <img src="/images/non-math/recovered/07-dew-flower.jpg" alt="Red flower covered in water droplets" loading="lazy" />
