---
import Header from '../components/Header.astro';
import '../styles/global.css';

const { title = 'Arye Deutsch', description = 'Arye Deutsch personal website' } = Astro.props.frontmatter || Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} — Arye Deutsch</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" integrity="sha384-GvrOXuhCSRgPpxT5xBSNcnt4zpvhLNTkmXwaEYiYMCqxEBSiE062E9X77ecX544g" crossorigin="anonymous">
</head>
<body>
  <Header currentPath={currentPath} />
  <main class="page-shell">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="site-footer-inner">
      Arye Deutsch
    </div>
  </footer>
</body>
</html>
